@startuml wall-controller
!include theme.puml

title Wall Controller - Embedded UI Architecture (ESP32-S3 + 7" TFT)

' ===== HARDWARE =====
rectangle "**Hardware Platform**" as hw {
    node "ESP32-S3-WROOM-1\n(Dual-core 240MHz, 8MB PSRAM)" as mcu {
        component "Core 0:\nUI Rendering\n(LVGL tick)" as core0
        component "Core 1:\nComms & Logic\n(WiFi, MQTT)" as core1
        component "PSRAM (8MB):\nFrame buffers\n+ UI assets" as psram
        component "Flash (16MB):\nFirmware + Assets\n(SPIFFS)" as flash
    }

    node "Display: 7\" TFT IPS\n800×480, Capacitive Touch" as display {
        component "ILI9806 Driver\n(16-bit parallel)" as lcd_driver
        component "GT911 Touch IC\n(I2C, 5-point multi-touch)" as touch
    }

    node "Peripherals" as periph {
        component "WS2812B LED Ring\n(Status indicator, 12 LEDs)" as led_ring
        component "Buzzer\n(Piezo, UI feedback)" as buzzer
        component "Ambient Light Sensor\n(Auto-brightness)" as als
        component "PIR Sensor\n(Wake-on-approach)" as pir
    }
}

' ===== SOFTWARE STACK =====
rectangle "**Software Stack**" as sw {

    rectangle "**UI Layer (LVGL v9)**" as ui_layer {
        component "Screen Manager\n(transitions, lifecycle)" as screen_mgr

        rectangle "Screens" as screens {
            component "Home Screen\n• Current temp (large)\n• Zone status icons\n• Quick mode buttons\n• Time/weather widget" as home_screen

            component "Zone Control\n• Per-zone temp slider\n• Damper open/close\n• Schedule override\n• Occupancy indicator" as zone_screen

            component "Climate Overview\n• Temp graph (24h)\n• Humidity graph (24h)\n• CO2 level bar\n• Filter status" as climate_screen

            component "Purge Control\n• Start/Stop purge\n• Progress bar\n• Air changes counter\n• Estimated completion" as purge_screen

            component "Settings\n• WiFi config\n• Display brightness\n• PIN change\n• System info" as settings_screen

            component "Login Screen\n• PIN pad (4-6 digit)\n• Fingerprint area\n• Quick unlock" as login_screen
        }

        component "Theme Engine\n(Dark/Light, auto-switch\nbased on time of day)" as theme_engine

        component "Widget Library\n• Temp gauge (arc)\n• Zone card\n• Status pill\n• Graph (line/bar)\n• Slider (custom)\n• Toggle switch" as widgets
    }

    rectangle "**Communication Layer**" as comm_layer {
        component "WiFi Manager\n(Auto-reconnect,\nmDNS registration)" as wifi_mgr
        component "MQTT Client\n(PubSubClient,\nQoS 1, LWT)" as mqtt
        component "HTTP Client\n(Auth, API calls,\nOTA updates)" as http
        component "mDNS\n(Registers:\nwall-ctrl.local)" as mdns_reg
    }

    rectangle "**State Management**" as state_layer {
        component "Zone State Cache\n(12 zones × {temp,\nsetpoint, mode, damper})" as zone_cache
        component "System State\n(mode, purge status,\nalarms, schedule)" as sys_state
        component "UI State\n(current screen,\nbrightness, theme)" as ui_state
        component "NVS Storage\n(Persistent settings,\nWiFi creds, PIN hash)" as nvs
    }

    rectangle "**Control Logic**" as logic_layer {
        component "MQTT Topic Router\n• home/status/zones/#\n• home/status/climate\n• home/status/purge\n• home/alerts/#" as topic_router
        component "Command Publisher\n• home/command/zone/+\n• home/command/purge\n• home/command/mode" as cmd_pub
        component "Watchdog\n(5s timeout,\nauto-reconnect)" as watchdog
        component "OTA Updater\n(Signed firmware,\nrollback support)" as ota
    }
}

' ===== CONNECTIONS =====
' Hardware
core0 --> lcd_driver : "16-bit parallel\n(DMA, 30fps)"
core1 --> wifi_mgr
touch --> screen_mgr : "I2C touch events"
als --> theme_engine : "Light level"
pir --> screen_mgr : "Wake display"
psram --> core0 : "Frame buffer\n(800×480×2 = 768KB)"

' Software layers
screen_mgr --> screens
screens --> widgets
screens --> zone_cache : "Read state"
screens --> cmd_pub : "User actions"

mqtt --> topic_router : "Incoming messages"
topic_router --> zone_cache : "Update state"
topic_router --> sys_state : "Update system"
zone_cache --> screens : "Trigger redraw"
sys_state --> screens : "Trigger redraw"

cmd_pub --> mqtt : "Publish commands"
http --> mdns_reg : "Discover controller"
wifi_mgr --> mqtt
wifi_mgr --> http

nvs --> zone_cache : "Restore on boot"
nvs --> ui_state : "Restore on boot"
watchdog --> wifi_mgr : "Reset on timeout"
ota --> flash : "Write new firmware"

' ===== MQTT TOPICS =====
note right of topic_router
  **Subscribed Topics:**
  home/status/zones/{id}     → Zone updates
  home/status/climate        → Temp/humidity/CO2
  home/status/purge          → Purge progress
  home/status/system         → System mode
  home/alerts/+              → Alarms
  
  **Published Topics:**
  home/command/zone/{id}/setpoint  → Change temp
  home/command/zone/{id}/mode      → Change mode
  home/command/purge/start         → Start purge
  home/command/purge/stop          → Stop purge
  home/command/mode                → System mode
end note

note bottom of hw
  **Power:**
  - 5V 2A USB-C (PoE adapter available)
  - Deep sleep: <10mA (PIR wake)
  - Active: ~350mA (display ON)
  
  **Mounting:**
  - Standard UK double gang box
  - 3D-printed bezel (flush mount)
  - Magnetic quick-release
end note

@enduml
