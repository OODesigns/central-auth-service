# Copy to .env and replace every secret before starting Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=postgres

APP_DB=auth_db
API_USER=app_user
API_PASSWORD=ReplaceWithAppPassword1!

# bcrypt hash consumed by Flyway; escape each $ as $$ for Compose interpolation.
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# At least 32 characters for HS256.
JWT_SECRET=replace-with-at-least-32-random-characters
# During rotation, set a new active variable and retain the old key until all
# refresh tokens signed with it have expired (currently seven days).
JWT_SECRET_PREVIOUS=
JWT_ACTIVE_KEY_ID=JWT_SECRET
JWT_PREVIOUS_KEY_IDS=

# Independent key used only for TOTP secret encryption at rest.
TOTP_ENCRYPTION_KEY=replace-with-a-different-32-character-random-key

KEYSTORE_PASSWORD=ReplaceWithKeystorePassword1!
TRUSTSTORE_PASSWORD=ReplaceWithTruststorePassword1!

GRPC_HOST_PORT=50051
TOTP_ISSUER=CentralAuthService

# Optional TLS paths inside the app container. Add matching read-only volume mounts
# to the app service in compose.yml when enabling TLS.
KEYSTORE_PATH=
TRUSTSTORE_PATH=
ALLOW_PLAINTEXT=false
RATE_LIMIT_BACKEND=database
