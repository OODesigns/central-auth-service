@startuml LoginCommunicationDiagram
!theme spacelab
title Login Authentication Flow - Communication Diagram

actor Client

package "Application Layer" {
    component Handler as "LoginCommandHandler"
    component DTO as "LoginCommand"
    component Result as "LoginResult"
}

note right of Handler
    Orchestrates login flow
    Coordinates services and repos
end note

note right of DTO
    Immutable input
    username, password
    ipAddress, userAgent
end note

note right of Result
    Output result
    success flag
    tokens & permissions
    error details
end note

package "Domain - Service Layer" {
    component AuthService as "AuthenticationService"
    component Clock as "Clock (Port)"
}

note right of AuthService
    Core auth logic
    Authenticate users
    Generate tokens
    Apply business rules
end note

note right of Clock
    Time provider
    Used for token TTL
end note

package "Domain - Repository & Entity" {
    component UserRepository as "UserRepository"
    component UserEntity as "User (Entity)"
}

note right of UserRepository
    Persistence abstraction
    Query users by username
    Port interface
end note

note right of UserEntity
    Domain entity
    Immutable aggregate root
    Contains roles & permissions
end note

package "Infrastructure/Ports" {
    component RateLimiter as "RateLimiter (Port)"
    component PasswordHasher as "PasswordHasher (Port)"
}

note right of RateLimiter
    Security boundary
    Limits login attempts by IP
    Port interface
end note

note right of PasswordHasher
    Security port
    Verify password against hash
end note

Client -.->|"1: LoginCommand"| Handler : request

Handler -->|"2a: checkLimit()"| RateLimiter
RateLimiter <--.|response| Handler

Handler -->|"2b: findByUsername()"| UserRepository
UserRepository <--.|"3: User"| Handler

Handler -->|"4: authenticate(user, password)"| AuthService
AuthService -->|"4a: verify password"| PasswordHasher
PasswordHasher <--.|"valid?"| AuthService

AuthService -->|"4b: get current time"| Clock
Clock <--.|"now"| AuthService

AuthService -->|"5: generateTokens(user)"| AuthService
AuthService <--.|"TokenPair"| Handler

Handler <--.|"6: LoginResult"| Handler
Handler -.->|"7: LoginResult"| Client : response



@enduml
