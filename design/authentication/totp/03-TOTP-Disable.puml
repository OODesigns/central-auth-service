@startuml TOTPDisable
!include ../../themes/dark-theme.puml
title Disable TOTP
hide footbox

actor User
participant "gRPC" as Grpc
participant "TOTP Handler" as Handler
participant "Security Service" as Security
database "Authentication API" as Db

User -> Grpc: DisableTotp(user_id, password, reason)
Grpc -> Handler: handle disable command
Handler -> Db: find credential hash
Handler -> Security: verify password and user_id
alt #F3B6BE99 INVALID PASSWORD
  Security -->> Handler: empty
  Handler -->> Grpc: INVALID_PASSWORD
  Grpc -->> User: error
else #C7E8C999 PASSWORD OK
  Security -->> Handler: verified user_id
  Handler -> Security: disable TOTP
  Security -> Db: delete TOTP and backup codes
  alt #F3B6BE99 NOT ENABLED
    Security -->> Handler: false
    Handler -->> Grpc: TOTP_NOT_ENABLED
    Grpc -->> User: error
  else #C7E8C999 OK
    Security -->> Handler: true
    Handler -->> Grpc: disable success
    Grpc -->> User: success
  end
end
@enduml