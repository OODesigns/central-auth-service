@startuml TotpLifecycle
!include ../themes/dark-theme.puml
title TOTP Enrollment, Login Verification, and Disable

actor User
participant "gRPC AuthService" as Grpc
participant "SetupTotpCommandHandler" as Setup
participant "EnableTotpCommandHandler" as Enable
participant "VerifyTotpCommandHandler" as Verify
participant "DisableTotpCommandHandler" as Disable
participant "TokenVerifier" as TokenVerifier
participant "TotpRateLimiter" as Limiter
participant "TotpVerifier" as TotpVerifier
participant "TotpSetupProvider" as Provider
participant "CredentialByIdReader" as Credentials
participant "AuthenticationService" as Auth
participant "UserRetriever" as Users
participant "TokenService" as Tokens
participant "RefreshTokenStore" as RefreshStore
database "api_schema functions" as Db

== Enrollment setup ==
User -> Grpc: SetupTotp(user_id, username)
Grpc -> Setup: handle(SetupTotpCommand)
Setup -> Provider: generateSecret(user_id)
Provider -> Db: store_totp_secret(encrypted pending secret)
Db -->> Provider: stored
Provider -->> Setup: Base32 secret
Setup -> Setup: build otpauth URI
Setup -->> Grpc: secret + URI
Grpc -->> User: SetupTotpSuccess

== Enrollment activation ==
User -> Grpc: EnableTotp(user_id, code)
Grpc -> Enable: handle(EnableTotpCommand)
Enable -> TotpVerifier: verifySetupCode(user_id, code)
TotpVerifier -> Db: get_pending_totp_secret(user_id)
alt Invalid setup code
  TotpVerifier -->> Enable: false
  Enable -->> Grpc: INVALID_TOTP_CODE
else Valid setup code
  TotpVerifier -->> Enable: true
  Enable -> Provider: enableTotp(user_id)
  Provider -> Db: enable_totp; verified_at = now
  alt Already active
    Provider -->> Enable: false
    Enable -->> Grpc: TOTP_ALREADY_ENABLED
  else Activated
    Provider -->> Enable: true
    Enable -> Provider: generateBackupCodes(user_id)
    Provider -> Db: replace BCrypt backup-code hashes
    Provider -->> Enable: plaintext codes
    Enable -->> Grpc: EnableTotpSuccess
    Grpc -->> User: backup codes (one-time display)
  end
end

== Login challenge completion ==
User -> Grpc: VerifyTotp(verification_token, code)
Grpc -> Verify: handle(VerifyTotpCommand)
Verify -> TokenVerifier: verify2FAVerificationToken(token)
alt Invalid or expired challenge token
  TokenVerifier -->> Verify: empty
  Verify -->> Grpc: INVALID_VERIFICATION_TOKEN
else Valid challenge token
  TokenVerifier -->> Verify: user_id
  Verify -> Limiter: checkLimit(user_id)
  alt Rate limited
    Limiter -->> Verify: blocked
    Verify -->> Grpc: RATE_LIMIT_EXCEEDED
  else Allowed
    Verify -> TotpVerifier: verify active TOTP or consume backup code
    TotpVerifier -> Db: active secret / unused backup hashes
    alt Invalid factor
      TotpVerifier -->> Verify: false
      Verify -->> Grpc: INVALID_TOTP_CODE
    else Valid factor
      TotpVerifier -->> Verify: true
      Verify -> Users: findById(user_id)
      Verify -> Tokens: generateTokens(user)
      Verify -> RefreshStore: issue(user_id, refresh token hash)
      RefreshStore -> Db: store_refresh_token
      Verify -->> Grpc: VerifyTotpSuccess
      Grpc -->> User: access + refresh tokens
    end
  end
end

== Disable ==
User -> Grpc: DisableTotp(user_id, password, reason)
Grpc -> Disable: handle(DisableTotpCommand)
Disable -> Credentials: findCredentialsByUserId(user_id)
Credentials -> Db: find_user_credentials_by_id
Disable -> Auth: verify password and matching user_id
alt Password invalid
  Auth -->> Disable: empty
  Disable -->> Grpc: INVALID_PASSWORD
else Password valid
  Auth -->> Disable: verified user_id
  Disable -> Provider: disableTotp(user_id, reason)
  Provider -> Db: disable_totp; cascade backup codes
  alt TOTP not enabled
    Provider -->> Disable: false
    Disable -->> Grpc: TOTP_NOT_ENABLED
  else Disabled
    Provider -->> Disable: true
    Disable -->> Grpc: DisableTotpSuccess
    Grpc -->> User: success
  end
end
@enduml