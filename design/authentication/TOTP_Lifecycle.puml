@startuml TotpEnrollmentSetup
!include ../themes/dark-theme.puml
title TOTP Enrollment Setup
hide footbox

actor User
participant "gRPC" as Grpc
participant "Setup Handler" as Setup
participant "TOTP Provider" as Provider
database "TOTP API" as Db

group #064e3b OK
User -> Grpc: SetupTotp(user_id, username)
Grpc -> Setup: handle(SetupTotpCommand)
Setup -> Provider: generateSecret(user_id)
Provider -> Db: store encrypted pending secret
Db -->> Provider: stored
Provider -->> Setup: Base32 secret
Setup -> Setup: build otpauth URI
Setup -->> Grpc: secret + URI
Grpc -->> User: SetupTotpSuccess
end
@enduml

@startuml TotpEnrollmentActivation
!include ../themes/dark-theme.puml
title TOTP Enrollment Activation
hide footbox

actor User
participant "gRPC" as Grpc
participant "Enable Handler" as Enable
participant "TOTP Verifier" as Verifier
participant "TOTP Provider" as Provider
database "TOTP API" as Db

User -> Grpc: EnableTotp(user_id, code)
Grpc -> Enable: handle(EnableTotpCommand)
Enable -> Verifier: verifySetupCode(user_id, code)
Verifier -> Db: get pending secret
alt #7f1d1d INVALID CODE
  Verifier -->> Enable: false
  Enable -->> Grpc: INVALID_TOTP_CODE
  Grpc -->> User: error
else #064e3b CODE OK
  Verifier -->> Enable: true
  Enable -> Provider: enableTotp(user_id)
  Provider -> Db: set verified_at
  alt #7f1d1d ALREADY ENABLED
    Provider -->> Enable: false
    Enable -->> Grpc: TOTP_ALREADY_ENABLED
    Grpc -->> User: error
  else #064e3b ENABLED
    Provider -->> Enable: true
    Enable -> Provider: generateBackupCodes(user_id)
    Provider -> Db: replace backup-code hashes
    Provider -->> Enable: plaintext codes
    Enable -->> Grpc: EnableTotpSuccess
    Grpc -->> User: backup codes\none-time display
  end
end
@enduml

@startuml TotpLoginChallenge
!include ../themes/dark-theme.puml
title TOTP Login Challenge
hide footbox

actor User
participant "gRPC" as Grpc
participant "Verify Handler" as Verify
participant "Token Verifier" as TokenVerifier
participant "TOTP Limiter" as Limiter
participant "TOTP Verifier" as TotpVerifier
participant "Users" as Users
participant "Tokens" as Tokens
participant "Refresh Store" as RefreshStore
database "TOTP API" as Db

User -> Grpc: VerifyTotp(token, factor)
Grpc -> Verify: handle(VerifyTotpCommand)
Verify -> TokenVerifier: verify challenge token
alt #7f1d1d INVALID TOKEN
  TokenVerifier -->> Verify: empty
  Verify -->> Grpc: INVALID_VERIFICATION_TOKEN
  Grpc -->> User: error
else #064e3b TOKEN OK
  TokenVerifier -->> Verify: user_id
  Verify -> Limiter: checkLimit(user_id)
  alt #7f1d1d BLOCKED
    Limiter -->> Verify: blocked
    Verify -->> Grpc: RATE_LIMIT_EXCEEDED
    Grpc -->> User: error
  else #064e3b ALLOWED
    Verify -> TotpVerifier: verify TOTP or backup code
    TotpVerifier -> Db: active secret or unused hashes
    alt #7f1d1d INVALID FACTOR
      TotpVerifier -->> Verify: false
      Verify -->> Grpc: INVALID_TOTP_CODE
      Grpc -->> User: error
    else #064e3b OK
      TotpVerifier -->> Verify: true
      Verify -> Users: findById(user_id)
      Verify -> Tokens: generateTokens(user)
      Verify -> RefreshStore: issue refresh token hash
      RefreshStore -> Db: store refresh token
      Verify -->> Grpc: VerifyTotpSuccess
      Grpc -->> User: access + refresh tokens
    end
  end
end
@enduml

@startuml TotpDisable
!include ../themes/dark-theme.puml
title Disable TOTP
hide footbox

actor User
participant "gRPC" as Grpc
participant "Disable Handler" as Disable
participant "Credentials" as Credentials
participant "Password Check" as Auth
participant "TOTP Provider" as Provider
database "TOTP API" as Db

User -> Grpc: DisableTotp(user_id, password, reason)
Grpc -> Disable: handle(DisableTotpCommand)
Disable -> Credentials: find by user_id
Credentials -> Db: find credential hash
Disable -> Auth: verify password and user_id
alt #7f1d1d INVALID PASSWORD
  Auth -->> Disable: empty
  Disable -->> Grpc: INVALID_PASSWORD
  Grpc -->> User: error
else #064e3b PASSWORD OK
  Auth -->> Disable: verified user_id
  Disable -> Provider: disableTotp(user_id, reason)
  Provider -> Db: delete TOTP and backup codes
  alt #7f1d1d NOT ENABLED
    Provider -->> Disable: false
    Disable -->> Grpc: TOTP_NOT_ENABLED
    Grpc -->> User: error
  else #064e3b OK
    Provider -->> Disable: true
    Disable -->> Grpc: DisableTotpSuccess
    Grpc -->> User: success
  end
end
@enduml