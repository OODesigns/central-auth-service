@startuml TOTP_Lifecycle
!include ../themes/dark-theme.puml
title TOTP Lifecycle
hide footbox

actor User
participant "gRPC API" as Grpc
participant "TOTP Commands" as Handler
database "Authentication API" as Db

group #C7E8C999 1. Enroll
User -> Grpc: SetupTotp / EnableTotp
Grpc -> Handler: create and verify enrollment
Handler -> Db: store encrypted secret
Handler -> Db: mark verified; store backup-code hashes
Handler -->> Grpc: setup complete
Grpc -->> User: secret, URI, and one-time backup codes
end

group #C7E8C999 2. Verify
User -> Grpc: VerifyTotp(token, factor)
Grpc -> Handler: verify challenge and factor
Handler -> Db: read active secret or backup-code hash
Handler -> Db: store refresh-token hash
Handler -->> Grpc: access and refresh tokens
Grpc -->> User: authenticated session
end

group #C7E8C999 3. Disable
User -> Grpc: DisableTotp(password, reason)
Grpc -> Handler: verify password and disable TOTP
Handler -> Db: delete secret and backup-code hashes
Handler -->> Grpc: disable complete
Grpc -->> User: TOTP disabled
end

note right of Handler
  Detailed flows:
  totp/01-TOTP-Enrollment.puml
  totp/02-TOTP-Verification.puml
  totp/03-TOTP-Disable.puml
end note
@enduml