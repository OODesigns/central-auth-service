@startuml
!include ../../themes/dark-theme.puml
title MFA Policy and TOTP Challenge Routing

:Receive user identity;
note right
  Entry point:
  Identity established
  (from Credential Verification)
 end note
start

:Load user policy and TOTP status;
note right
  UserRetriever loads mfaRequiredAt,
  passwordResetRequiredAt, and permissions.
  TotpStatusReader checks verified_at.
 end note

if (Required but\nnot enrolled?) then (yes)
  :Return MFA_SETUP_REQUIRED via gRPC;
  end
endif


if (TOTP enabled?) then (yes)
  :Issue 2FA verification JWT; <<warning>>
  note right
    Generated by TokenService.
    VerifyTotp accepts this token plus
    a live TOTP code or one backup code.
  end note
  :Return Login2FARequired;
  end
else (no)
  if (Password reset required?) then (yes)
    :Return PasswordResetRequired;
    end
  else (no)
    :Continue to full token issuance;
  endif
endif

:Continue authentication\n(Post Authentication);


end
@enduml
