' ===============================
' Activity start / end nodes (SUPPORTED)
' ===============================
skinparam activityStartColor #ffffff
skinparam activityStartBorderColor #000000

skinparam activityEndColor #ffffff
skinparam activityEndBorderColor #000000

' ===============================
' Canvas & global defaults
' ===============================
skinparam backgroundColor #ffffff
skinparam defaultFontColor #000000
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 6
skinparam maxMessageSize 110
skinparam sequenceMessageAlign center

skinparam ArrowColor #000000
skinparam ArrowFontSize 15
skinparam BorderColor #000000

' ===============================
' Architecture, sequence, and data-model elements
' ===============================
skinparam Participant {
  BackgroundColor #E8F1FB
  BorderColor #000000
  FontColor #000000
  FontSize 16
}

skinparam Actor {
  BackgroundColor #E8F1FB
  BorderColor #000000
  FontColor #000000
  FontSize 16
}

skinparam Component {
  BackgroundColor #FFF4CC
  BorderColor #000000
  FontColor #000000
}

skinparam Interface {
  BackgroundColor #FFF4CC
  BorderColor #000000
  FontColor #000000
}

skinparam Database {
  BackgroundColor #E8F5E9
  BorderColor #000000
  FontColor #000000
}

skinparam Entity {
  BackgroundColor #E8F5E9
  BorderColor #000000
  FontColor #000000
}

skinparam entityBackgroundColor #E8F5E9
skinparam entityBorderColor #000000
skinparam entityFontColor #000000
skinparam classBackgroundColor #E8F5E9
skinparam classBorderColor #000000
skinparam classFontColor #000000

skinparam Class {
  BackgroundColor #E8F5E9
  BorderColor #000000
  FontColor #000000
  AttributeFontColor #000000
}

skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBodyBackgroundColor #ffffff
skinparam SequenceGroupHeaderBackgroundColor #ffffff
skinparam SequenceGroupHeaderFontColor #000000
skinparam SequenceGroupFontSize 16
skinparam SequenceDividerBackgroundColor #ffffff
skinparam SequenceDividerBorderColor #000000
skinparam SequenceDividerFontColor #000000

skinparam Package {
  BackgroundColor #F3E8FF
  BorderColor #000000
