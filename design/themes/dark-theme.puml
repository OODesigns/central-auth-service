skinparam Folder {
  BackgroundColor #F3E8FF
  BorderColor #000000
  FontColor #000000
}

skinparam Cloud {
  BackgroundColor #F3E8FF
  BorderColor #000000
  FontColor #000000
}

' ===============================
' Activities (normal flow)
' ===============================
skinparam Activity {
  BackgroundColor #F5F5F5
  BorderColor #000000
  FontColor #000000
}

' ===============================
' Decision diamonds
' ===============================
skinparam Diamond {
  BackgroundColor #ffffff
  BorderColor #000000
  FontColor #000000
}

' ===============================
' Semantic activity variants
' ===============================

skinparam Activity<<failure>> {
  BackgroundColor #F3B6BE99
  BorderColor #D98C98
  FontColor #000000
}

skinparam Activity<<warning>> {
  BackgroundColor #F59E0B
  BorderColor #000000
  FontColor #000000
}

skinparam Activity<<success>> {
  BackgroundColor #C7E8C999
  BorderColor #91B993
  FontColor #111827
}

' ===============================
' Notes (data / DB calls / intent)
' ===============================
skinparam Note {
  BackgroundColor #ffffff
  BorderColor #000000
  FontColor #000000
}

' ===============================
' Partitions / security boundaries
' ===============================
skinparam Partition {
  BackgroundColor #ffffff
  BorderColor #000000
  FontColor #000000
}
