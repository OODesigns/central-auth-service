' ===============================
' Activity start / end nodes (SUPPORTED)
' ===============================
skinparam activityStartColor #22c55e
skinparam activityStartBorderColor #16a34a

skinparam activityEndColor #64748b
skinparam activityEndBorderColor #94a3b8

' ===============================
' Canvas & global defaults
' ===============================
skinparam backgroundColor #12161c
skinparam defaultFontColor #e5e7eb
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 6
skinparam maxMessageSize 110
skinparam sequenceMessageAlign center

skinparam ArrowColor #93c5fd
skinparam ArrowFontSize 15
skinparam BorderColor #4b5563

' ===============================
' Architecture, sequence, and data-model elements
' ===============================
skinparam Participant {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
  FontSize 16
}

skinparam Actor {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
  FontSize 16
}

skinparam Component {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
}

skinparam Interface {
  BackgroundColor #1f2937
  BorderColor #93c5fd
  FontColor #f9fafb
}

skinparam Database {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
}

skinparam Entity {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
}

skinparam Class {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
  AttributeFontColor #f9fafb
}

skinparam SequenceGroupBorderColor #38bdf8
skinparam SequenceGroupBodyBackgroundColor #0b1220
skinparam SequenceGroupHeaderBackgroundColor #1f2937
skinparam SequenceGroupHeaderFontColor #111827
skinparam SequenceGroupFontSize 16
skinparam SequenceDividerBackgroundColor #1f2937
skinparam SequenceDividerBorderColor #94a3b8
skinparam SequenceDividerFontColor #f9fafb

skinparam Package {
  BackgroundColor #0b1220
  BorderColor #38bdf8
  FontColor #38bdf8
}

skinparam Folder {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
}

skinparam Cloud {
  BackgroundColor #1f2937
  BorderColor #94a3b8
  FontColor #f9fafb
}

' ===============================
' Activities (normal flow)
' ===============================
skinparam Activity {
  BackgroundColor #1f2937
  BorderColor #6b7280
  FontColor #f9fafb
}

' ===============================
' Decision diamonds
' ===============================
skinparam Diamond {
  BackgroundColor #020617
  BorderColor #60a5fa
  FontColor #60a5fa
}

' ===============================
' Semantic activity variants
' ===============================

skinparam Activity<<failure>> {
  BackgroundColor #7f1d1d
  BorderColor #ef4444
  FontColor #fee2e2
}

skinparam Activity<<warning>> {
  BackgroundColor #78350f
  BorderColor #f59e0b
  FontColor #fef3c7
}

skinparam Activity<<success>> {
  BackgroundColor #064e3b
  BorderColor #22c55e
  FontColor #dcfce7
}

' ===============================
' Notes (data / DB calls / intent)
' ===============================
skinparam Note {
  BackgroundColor #2a303a
  BorderColor #9ca3af
  FontColor #f3f4f6
}

' ===============================
' Partitions / security boundaries
' ===============================
skinparam Partition {
  BackgroundColor #0b1220
  BorderColor #38bdf8
  FontColor #38bdf8
}
