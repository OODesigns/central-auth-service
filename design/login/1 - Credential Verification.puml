@startuml
!include ../themes/dark-theme.puml
title Credential Verification

start

:Receive username + password;

:get credentials;
note right
  <<Credentials Store>>
  user_id
  password_hash

end note

if (Password valid) then (yes)
  :Identity established;
else (no)
  :Reject login; <<failure>>
  end
endif

:Continue authentication\n(MFA Policy & Challenge);

end
@enduml
