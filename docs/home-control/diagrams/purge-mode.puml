@startuml purge-mode
!theme plain

state "Normal Mode" as NORMAL {
  [*] --> MVHR_ACTIVE
  MVHR_ACTIVE : Blauberg MVHR running\nActuators -> MVHR path
}

state "Night Purge Mode" as PURGE_MODE {
  [*] --> ACT_SWITCH
  ACT_SWITCH : Actuators switch to purge path
  ACT_SWITCH --> PURGE_FAN
  PURGE_FAN : Supply fan expels hot air\nSecond fan draws cool night air
  PURGE_FAN --> BYPASS_MVHR
  BYPASS_MVHR : Air bypasses MVHR heat exchanger
}

NORMAL --> PURGE_MODE : Trigger:\noutdoor temp < indoor temp\nOR manual override
PURGE_MODE --> NORMAL : Trigger:\ndawn / temp threshold\nOR manual override
@enduml
