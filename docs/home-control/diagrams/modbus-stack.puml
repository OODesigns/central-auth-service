@startuml modbus-stack
!include theme.puml

title Modbus RS485 Bus - Device Address Assignment

rectangle "Raspberry Pi 4\n**Modbus Master**" as master {
    component "USB-RS485 Adapter\n(/dev/ttyUSB0)" as usb
    note right of usb
        Baud: 9600
        Data: 8N1
        Protocol: Modbus RTU
        Timeout: 1000ms
        Poll interval: 250ms
    end note
}

rectangle "RS485 Bus (Daisy Chain Topology)" as bus {

    node "**Address 0x01**\nWaveshare 16-ch Relay\nModbus RTU" as dev1 {
        rectangle "Coils (0x0000-0x000F)" as d1_coils {
            component "Coil 0-7:\nZone Dampers 1-8" as d1c_dampers
            component "Coil 8:\nSupply Fan" as d1c_fan
            component "Coil 9:\nReturn Fan" as d1c_rfan
            component "Coil 10:\nHeater Stage 1" as d1c_heat1
            component "Coil 11:\nHeater Stage 2" as d1c_heat2
            component "Coil 12:\nCooling Compressor" as d1c_cool
            component "Coil 13:\nHumidifier" as d1c_humid
            component "Coil 14-15:\nSpare" as d1c_spare
        }
    }

    node "**Address 0x02**\nWaveshare 8-ch Relay\nModbus RTU" as dev2 {
        rectangle "Coils (0x0000-0x0007)" as d2_coils {
            component "Coil 0-3:\nAux Zone Dampers 9-12" as d2c_aux
            component "Coil 4:\nFresh Air Intake Damper" as d2c_fresh
            component "Coil 5:\nExhaust Damper" as d2c_exhaust
            component "Coil 6:\nBypass Damper" as d2c_bypass
            component "Coil 7:\nAlarm Indicator" as d2c_alarm
        }
    }

    node "**Address 0x03**\nWaveshare 8-ch Relay\nModbus RTU" as dev3 {
        rectangle "Coils (0x0000-0x0007)" as d3_coils {
            component "Coil 0:\nPurge Supply Damper" as d3c_purge_supply
            component "Coil 1:\nPurge Exhaust Damper" as d3c_purge_exhaust
            component "Coil 2:\nPurge Fan High Speed" as d3c_purge_fan
            component "Coil 3:\nPurge Bypass Valve" as d3c_purge_bypass
            component "Coil 4:\nPurge Indicator LED" as d3c_purge_led
            component "Coil 5:\nPurge Complete Signal" as d3c_purge_done
            component "Coil 6:\nSafety Interlock (Fire)" as d3c_fire
            component "Coil 7:\nSafety Interlock (Smoke)" as d3c_smoke
        }
    }

    node "**Address 0x04**\nWaveshare 8AI/8AO\nAnalog I/O Module" as dev4 {
        rectangle "Input Registers (0x0000-0x0007)" as d4_ai {
            component "AI 0: Supply Air Temp\n(NTC 10k, 0-50°C)" as d4_t1
            component "AI 1: Return Air Temp\n(NTC 10k, 0-50°C)" as d4_t2
            component "AI 2: Outside Air Temp\n(NTC 10k, -20-60°C)" as d4_t3
            component "AI 3: Room Temp Average\n(NTC 10k, 0-50°C)" as d4_t4
            component "AI 4: Supply Humidity\n(4-20mA, 0-100%RH)" as d4_h1
            component "AI 5: Room Humidity\n(4-20mA, 0-100%RH)" as d4_h2
            component "AI 6: CO2 Level\n(0-10V, 0-2000ppm)" as d4_co2
            component "AI 7: Filter ΔP\n(4-20mA, 0-500Pa)" as d4_dp
        }
        rectangle "Holding Registers (0x0000-0x0007)" as d4_ao {
            component "AO 0: Supply Fan Speed\n(0-10V → 0-100%)" as d4_fan1
            component "AO 1: Return Fan Speed\n(0-10V → 0-100%)" as d4_fan2
            component "AO 2: Fresh Air Fan\n(0-10V → 0-100%)" as d4_fan3
            component "AO 3: Exhaust Fan\n(0-10V → 0-100%)" as d4_fan4
            component "AO 4: Hot Water Valve\n(0-10V → 0-100%)" as d4_hw
            component "AO 5: Chilled Water Valve\n(0-10V → 0-100%)" as d4_cw
            component "AO 6: Supply Damper Pos\n(0-10V → 0-100°)" as d4_sd
            component "AO 7: Return Damper Pos\n(0-10V → 0-100°)" as d4_rd
        }
    }
}

' Connections
master -down-> dev1 : "RS485"
dev1 -down-> dev2 : "Daisy\nChain"
dev2 -down-> dev3 : "Daisy\nChain"
dev3 -down-> dev4 : "Daisy\nChain"

note bottom of bus
    **Bus Configuration:**
    - Topology: Daisy chain with 120Ω termination at each end
    - Max cable length: 1200m (actual ~30m)
    - Total devices: 4 (max 247 on Modbus RTU)
    - Scan cycle: ~100ms for all 4 devices
end note

@enduml
