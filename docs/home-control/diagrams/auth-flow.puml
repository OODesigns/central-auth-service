@startuml auth-flow
!theme plain
skinparam sequenceMessageAlign center

actor User
participant "Mobile/Web App" as APP
participant "AWS Bridge\n(API Gateway / IoT)" as AWS
participant "Central Auth Service\n(local)" as CAS
participant "Home Control Service" as HCS

== Remote Access ==
User -> APP : login
APP -> AWS : POST /auth (credentials)
AWS -> CAS : validate token request\n(outbound from local)
CAS -> AWS : JWT issued
AWS -> APP : JWT
APP -> AWS : control command + JWT
AWS -> HCS : forwarded command\n(via persistent outbound tunnel)
HCS -> CAS : verify JWT
CAS -> HCS : authorised
HCS -> HCS : execute command

== Local Access ==
User -> APP : login (on LAN)
APP -> CAS : direct POST /auth
CAS -> APP : JWT
APP -> HCS : control command + JWT
HCS -> CAS : verify JWT
CAS -> HCS : authorised
HCS -> HCS : execute command
@enduml
