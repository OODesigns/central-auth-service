@startuml io-assignment
!include theme.puml

title I/O Channel Assignment - Complete Mapping

' ===== ANALOG INPUTS (8 channels) =====
rectangle "**Analog Inputs (8 AI)** — Waveshare Module Addr 0x04\nInput Registers 0x0000-0x0007 (16-bit, 0-4095 raw)" as ai_block {

    rectangle "Temperature Sensors (NTC 10kΩ @ 25°C)" as temp_group {
        component "**AI 0** — Supply Air Temperature\nRange: 0–50°C | Resolution: 0.1°C\nSensor: NTC 10k (B=3950)\nCalibration: Steinhart-Hart\nAlarm: >45°C high, <5°C low" as ai0

        component "**AI 1** — Return Air Temperature\nRange: 0–50°C | Resolution: 0.1°C\nSensor: NTC 10k (B=3950)\nUsed for: ΔT calculation" as ai1

        component "**AI 2** — Outside Air Temperature\nRange: -20–60°C | Resolution: 0.1°C\nSensor: NTC 10k (B=3950)\nUsed for: Economizer control, frost protect" as ai2

        component "**AI 3** — Room Temperature (Average)\nRange: 0–50°C | Resolution: 0.1°C\nSensor: NTC 10k (B=3950)\nUsed for: Primary control variable" as ai3
    }

    rectangle "Humidity Sensors (4-20mA)" as humidity_group {
        component "**AI 4** — Supply Air Humidity\nRange: 0–100% RH | Signal: 4-20mA\nSensor: Capacitive probe\nUsed for: Humidifier/dehumidifier control" as ai4

        component "**AI 5** — Room Humidity\nRange: 0–100% RH | Signal: 4-20mA\nSensor: Capacitive probe\nSetpoint: 40-60% RH" as ai5
    }

    rectangle "Air Quality & Pressure" as aq_group {
        component "**AI 6** — CO₂ Level\nRange: 0–2000 ppm | Signal: 0-10V\nSensor: NDIR CO₂ sensor\nSetpoint: <800ppm (occupied)\nAlarm: >1500ppm" as ai6

        component "**AI 7** — Filter Differential Pressure\nRange: 0–500 Pa | Signal: 4-20mA\nSensor: DP transmitter\nAlarm: >250 Pa (filter dirty)" as ai7
    }
}

' ===== ANALOG OUTPUTS (8 channels) =====
rectangle "**Analog Outputs (8 AO)** — Waveshare Module Addr 0x04\nHolding Registers 0x0000-0x0007 (16-bit, 0-4095 raw → 0-10V)" as ao_block {

    rectangle "Fan Speed Control (VFD 0-10V input)" as fan_group {
        component "**AO 0** — Supply Fan Speed\n0-10V → 0-100% | Min: 20% (prevent stall)\nRamp: 5%/sec up, 10%/sec down" as ao0

        component "**AO 1** — Return Fan Speed\nTracks AO 0 minus offset (building pressure)\n0-10V → 0-100% | Offset: -10%" as ao1

        component "**AO 2** — Fresh Air Fan Speed\n0-10V → 0-100% | Economizer mode\nInterlocked with fresh air damper" as ao2

        component "**AO 3** — Exhaust Fan Speed\n0-10V → 0-100% | Tracks fresh air\nInterlocked with exhaust damper" as ao3
    }

    rectangle "Valve & Damper Actuators (0-10V)" as valve_group {
        component "**AO 4** — Hot Water Valve Position\n0-10V → 0-100% open\nFail position: CLOSED (spring return)\n3-point actuator, 90sec full stroke" as ao4

        component "**AO 5** — Chilled Water Valve Position\n0-10V → 0-100% open\nFail position: CLOSED (spring return)\nInterlock: Cannot open with heating" as ao5

        component "**AO 6** — Supply Damper Position\n0-10V → 0-100° rotation\nFail position: CLOSED (spring return)\n60sec full stroke" as ao6

        component "**AO 7** — Return Damper Position\n0-10V → 0-100° rotation\nFail position: OPEN (spring return)\n60sec full stroke" as ao7
    }
}

' ===== RELAY OUTPUTS (30 channels total) =====
rectangle "**Relay Outputs (30 channels)** — 3× Waveshare Relay Modules" as relay_block {

    rectangle "**Module 1 (Addr 0x01) — 16 Relays** | Main Equipment" as m1 {
        component "R1.0–R1.7: Zone Dampers 1-8 (OPEN/CLOSE)" as m1_zones
        component "R1.8: Supply Fan Contactor (ON/OFF)" as m1_sfan
        component "R1.9: Return Fan Contactor (ON/OFF)" as m1_rfan
        component "R1.10: Heater Stage 1 (Electric/Gas)" as m1_h1
        component "R1.11: Heater Stage 2 (Electric only)" as m1_h2
        component "R1.12: Cooling Compressor (ON/OFF)" as m1_cool
        component "R1.13: Humidifier Solenoid (ON/OFF)" as m1_humid
        component "R1.14: UV-C Sterilizer (ON/OFF)" as m1_uv
        component "R1.15: Spare" as m1_spare
    }

    rectangle "**Module 2 (Addr 0x02) — 8 Relays** | Auxiliary Dampers" as m2 {
        component "R2.0–R2.3: Aux Zone Dampers 9-12" as m2_zones
        component "R2.4: Fresh Air Intake Damper (motor)" as m2_fresh
        component "R2.5: Exhaust Damper (motor)" as m2_exhaust
        component "R2.6: Heat Recovery Bypass" as m2_bypass
        component "R2.7: Alarm Horn/Indicator" as m2_alarm
    }

    rectangle "**Module 3 (Addr 0x03) — 8 Relays** | Purge & Safety" as m3 {
        component "R3.0: Purge Supply Damper (full open)" as m3_ps
        component "R3.1: Purge Exhaust Damper (full open)" as m3_pe
        component "R3.2: Purge Fan High Speed Override" as m3_pf
        component "R3.3: Purge Bypass Valve" as m3_pb
        component "R3.4: Purge Active Indicator" as m3_pi
        component "R3.5: Purge Complete Signal" as m3_pc
        component "R3.6: Fire Safety Interlock (N/C)" as m3_fire
        component "R3.7: Smoke Safety Interlock (N/C)" as m3_smoke
    }
}

legend right
  **I/O Summary**
  |= Type |= Count |= Module |
  | Analog Inputs | 8 | Addr 0x04 |
  | Analog Outputs | 8 | Addr 0x04 |
  | Relay Outputs | 16 | Addr 0x01 |
  | Relay Outputs | 8 | Addr 0x02 |
  | Relay Outputs | 8 | Addr 0x03 (2 safety) |
  | **Total I/O** | **48** | **4 modules** |
endlegend

@enduml
