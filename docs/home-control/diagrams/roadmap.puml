@startuml roadmap
!include theme.puml

title Home Control System - Phased Delivery Roadmap

' Use Gantt-style with project/WBS notation
rectangle "**Phase 1: Foundation (Weeks 1-3)**\nHardware Setup + Basic Control" as phase1 #16213e {

    rectangle "Week 1: Hardware Assembly" as w1 {
        component "• Mount Modbus relay modules in panel" as w1a
        component "• Wire RS485 daisy chain (4 devices)" as w1b
        component "• Install USB-RS485 adapter on Pi" as w1c
        component "• Wire NTC temperature sensors (4x)" as w1d
        component "• Wire 4-20mA humidity sensors (2x)" as w1e
        component "• Power supply + fusing" as w1f
    }

    rectangle "Week 2: Pi Software Base" as w2 {
        component "• Install Java 22 + Gradle on Pi" as w2a
        component "• Implement Modbus RTU master (jSerialComm)" as w2b
        component "• Read all 8 analog inputs" as w2c
        component "• Write all 30 relay coils" as w2d
        component "• Set all 8 analog outputs" as w2e
        component "• Basic polling loop (250ms cycle)" as w2f
    }

    rectangle "Week 3: Local MQTT + Basic Control" as w3 {
        component "• Install Mosquitto on Pi" as w3a
        component "• MQTT pub/sub for sensor data" as w3b
        component "• Simple thermostat logic (on/off)" as w3c
        component "• Zone damper open/close by schedule" as w3d
        component "• SQLite state persistence" as w3e
        component "• Basic logging (sensor history)" as w3f
    }
}

rectangle "**Phase 2: Intelligence (Weeks 4-6)**\nPID Control + Purge Mode" as phase2 #0f3460 {

    rectangle "Week 4: PID Control" as w4 {
        component "• PID controller (supply temp → valve)" as w4a
        component "• Fan speed control (CO2 → fresh air)" as w4b
        component "• Heating staging (2-stage + modulating)" as w4c
        component "• Cooling interlock logic" as w4d
        component "• Anti-short-cycle timers" as w4e
    }

    rectangle "Week 5: Purge Mode" as w5 {
        component "• Purge state machine (6 stages)" as w5a
        component "• Safety interlock monitoring" as w5b
        component "• Air change calculation" as w5c
        component "• Damper position feedback" as w5d
        component "• Emergency abort sequence" as w5e
        component "• Schedule-based auto-purge" as w5f
    }

    rectangle "Week 6: Economizer + Optimization" as w6 {
        component "• Free cooling (outside temp logic)" as w6a
        component "• Humidity control (humidify/dehumidify)" as w6b
        component "• Filter pressure monitoring + alerts" as w6c
        component "• Night setback scheduling" as w6d
        component "• Occupancy-based optimization" as w6e
    }
}

rectangle "**Phase 3: User Interface (Weeks 7-9)**\nWall Controller + Mobile" as phase3 #533483 {

    rectangle "Week 7: Wall Controller Hardware" as w7 {
        component "• ESP32-S3 + 7\" TFT assembly" as w7a
        component "• LVGL framework setup" as w7b
        component "• Touch calibration" as w7c
        component "• WiFi + mDNS discovery" as w7d
        component "• MQTT client integration" as w7e
    }

    rectangle "Week 8: Wall Controller UI" as w8 {
        component "• Home screen (temp, status)" as w8a
        component "• Zone control screen (sliders)" as w8b
        component "• Climate overview (graphs)" as w8c
        component "• Purge control screen" as w8d
        component "• Settings + PIN login" as w8e
        component "• Dark/light theme auto-switch" as w8f
    }

    rectangle "Week 9: Local Auth + Polish" as w9 {
        component "• JWT auth (Pi ↔ Wall Controller)" as w9a
        component "• Rate limiting + PIN lockout" as w9b
        component "• PIR wake-on-approach" as w9c
        component "• Auto-brightness (ambient sensor)" as w9d
        component "• OTA firmware updates" as w9e
        component "• UI animations + transitions" as w9f
    }
}

rectangle "**Phase 4: Cloud & Remote (Weeks 10-12)**\nAWS Integration + Mobile App" as phase4 #e94560 {

    rectangle "Week 10: AWS Infrastructure" as w10 {
        component "• IoT Core setup (thing, certs, policy)" as w10a
        component "• Cognito user pool + admin group" as w10b
        component "• API Gateway + Lambda proxy" as w10c
        component "• DynamoDB state mirror" as w10d
        component "• Pi ↔ AWS IoT MQTT bridge" as w10e
    }

    rectangle "Week 11: Remote Access" as w11 {
        component "• Mobile app (React Native / Flutter)" as w11a
        component "• Cognito auth flow (SRP + MFA)" as w11b
        component "• Remote zone control" as w11c
        component "• Push notifications (alerts)" as w11d
        component "• Historical data dashboard" as w11e
    }

    rectangle "Week 12: Integration & Testing" as w12 {
        component "• End-to-end testing (local + remote)" as w12a
        component "• Failover testing (internet loss)" as w12b
        component "• Security audit (pen test basics)" as w12c
        component "• Performance tuning (latency)" as w12d
        component "• Documentation finalization" as w12e
        component "• Family training + handoff" as w12f
    }
}

' ===== DEPENDENCIES =====
phase1 -down-> phase2 : "Hardware\nready"
phase2 -down-> phase3 : "Control\nlogic ready"
phase3 -down-> phase4 : "Local system\ncomplete"

' ===== MILESTONES =====
note right of phase1
  **Milestone 1:** ✅
  "I can read sensors and
   toggle relays from Pi"
end note

note right of phase2
  **Milestone 2:**
  "House temperature is
   automatically controlled"
end note

note right of phase3
  **Milestone 3:**
  "Family can control system
   from wall panel"
end note

note right of phase4
  **Milestone 4:**
  "Full remote access and
   monitoring from anywhere"
end note

legend bottom
  |= Phase |= Duration |= Key Deliverable |
  | Phase 1: Foundation | 3 weeks | Basic I/O working end-to-end |
  | Phase 2: Intelligence | 3 weeks | Automated temperature control + purge |
  | Phase 3: User Interface | 3 weeks | Touch-screen wall controller operational |
  | Phase 4: Cloud & Remote | 3 weeks | AWS remote access + mobile app |
  | **Total** | **12 weeks** | **Complete home control system** |
endlegend

@enduml
